def neighbourMaskAt (index : Nat) : Bits := neighbourMasks.getD index 0

def hasAdjacentBit (bits : Bits) (sq : AnySquare) : Bool :=
  (bits &&& neighbourMaskAt sq.val) != 0

def bracketableAdjacent (square cell : Nat) : Bool :=
  let file : Int := square % 8
  let rank : Int := square / 8
  let dx : Int := (cell % 8 : Nat) - file
  let dy : Int := (cell / 8 : Nat) - rank
  decide (square < 64 ∧ cell < 64 ∧
    -1 ≤ dx ∧ dx ≤ 1 ∧ -1 ≤ dy ∧ dy ≤ 1 ∧ (dx ≠ 0 ∨ dy ≠ 0) ∧
    0 ≤ file + 2 * dx ∧ file + 2 * dx < 8 ∧
    0 ≤ rank + 2 * dy ∧ rank + 2 * dy < 8)

end NeuralReversi.Bitboard
